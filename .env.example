# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# Neon (or any Postgres). Use the POOLED endpoint — the host with `-pooler` in
# it — for serverless deployments: each function instance opens its own
# connections and the pooler is what keeps that from exhausting the database.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Where photos live: db (default, works anywhere) or disk (needs a real volume).
MEDIA_BACKEND=db

# Absolute URL burned into printed QR labels. Set this before printing anything
# you intend to keep — labels are expensive to redo.
# PUBLIC_BASE_URL=https://home-repo.example.com

# One shared passcode that locks the whole app (8+ characters; longer is better).
# Leave unset on a home network. Set it on anything reachable from the internet.
# APP_PASSCODE=
