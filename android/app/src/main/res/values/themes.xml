<resources>
    <!-- The launch window before Compose draws: the app's own surface, so there is no flash. -->
    <style name="Theme.HomeRepo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_surface</item>
    </style>
    <color name="launch_surface">#F8F7F5</color>
    <!-- The launcher icon's background layer: the tile colour of the app
         artwork, so the mask shape reads as the artwork's own surface. -->
    <color name="launcher_ground">#EFEEEE</color>
</resources>
