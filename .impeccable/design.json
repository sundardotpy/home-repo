      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-chip-on\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M5 12l5 5 9-10\"/></svg>Your things</button><button class=\"ds-chip\">Decluttered</button><button class=\"ds-chip\">All</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{font-family: system-ui, Roboto, sans-serif;display:inline-flex;align-items:center;gap:8px;height:32px;padding:0 16px;border:1px solid #C3CCCA;border-radius:8px;background:transparent;color:#4A5557;font-size:14px;font-weight:500;cursor:pointer}.ds-chip:hover{background:rgba(28,35,38,.06)}.ds-chip:focus-visible{outline:2px solid #0E5E58;outline-offset:2px}.ds-chip-on{border-color:transparent;background:#CCE8E3;color:#05201D;padding-left:8px}"
