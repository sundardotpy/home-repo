      "html": "<div class=\"ds-row\" tabindex=\"0\"><div class=\"ds-avatar\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"6\" y=\"3\" width=\"12\" height=\"18\" rx=\"2\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg></div><div class=\"ds-row-main\"><div class=\"ds-row-name\">Passport</div><div class=\"ds-row-path\"><span class=\"ds-row-spine\"></span><div class=\"ds-row-tabs\"><span class=\"ds-row-tab ds-row-room\">Bedroom</span><span class=\"ds-row-tab\" style=\"margin-left:10px\">Wardrobe</span></div></div></div></div>",
      "css": ".ds-row{font-family: system-ui, Roboto, sans-serif;display:flex;gap:14px;padding:12px 16px;background:#F4F7F6;color:#1C2326;cursor:pointer;transition:background .15s}.ds-row:hover{background:#E8EEED}.ds-row:focus-visible{outline:2px solid #0E5E58;outline-offset:-2px}.ds-avatar{width:40px;height:40px;flex-shrink:0;border-radius:14px;background:#D3E5F6;color:#12344F;display:flex;align-items:center;justify-content:center}.ds-row-main{display:flex;flex-direction:column;gap:6px}.ds-row-name{font-size:16px;font-weight:500;line-height:24px;letter-spacing:.15px}.ds-row-path{display:flex;gap:8px}.ds-row-spine{width:2px;border-radius:1px;background:#C3CCCA}.ds-row-tabs{display:flex;flex-direction:column;align-items:flex-start;gap:3px}.ds-row-tab{min-height:22px;box-sizing:border-box;display:inline-flex;align-items:center;padding:1px 9px;border-radius:6px;border:1px solid rgba(195,204,202,.7);background:#FFFFFF;font-size:12px;font-weight:500;letter-spacing:.5px}.ds-row-room{background:#CDEBE1;color:#0F3D33}"
