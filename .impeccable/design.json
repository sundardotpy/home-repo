      "description": "The signature: a location as drawer tabs down one 2dp spine; room tab tinted, inner tabs are slip labels, 10dp indent per level, fixed 22dp height.",
      "html": "<div class=\"ds-path\" aria-label=\"In Bedroom, Wardrobe, Documents folder\"><span class=\"ds-path-spine\"></span><div class=\"ds-path-tabs\"><span class=\"ds-tab ds-tab-room\">Bedroom</span><span class=\"ds-tab\" style=\"margin-left:10px\">Wardrobe</span><span class=\"ds-tab\" style=\"margin-left:20px\">Documents folder</span></div></div>",
      "css": ".ds-path{display:flex;gap:8px;background:#F4F7F6;padding:8px 16px}.ds-path-spine{width:2px;border-radius:1px;background:#C3CCCA}.ds-path-tabs{display:flex;flex-direction:column;align-items:flex-start;gap:3px}.ds-tab{font-family: system-ui, Roboto, sans-serif;box-sizing:border-box;min-height:22px;display:inline-flex;align-items:center;padding:1px 9px;border-radius:6px;border:1px solid rgba(195,204,202,.7);background:#FFFFFF;color:#1C2326;font-size:12px;font-weight:500;line-height:16px;letter-spacing:.5px;white-space:nowrap}.ds-tab-room{background:#CDEBE1;color:#0F3D33}"
    },
